# ===== Model API =====
# ARK (Volcengine / OpenAI-compatible) API key
OPENAI_API_KEY=your_ark_api_key_here

# ===== Sandbox (Volcengine VeFaaS) =====
# The HTTP endpoint exposed by your sandbox FaaS function
SANDBOX_ENDPOINT=https://<your-sandbox-id>.apigateway-cn-beijing.volceapi.com

# The FaaS function ID used to create sandbox instances on-demand
SANDBOX_APP_ID=your_function_id

# Volcengine Access Key credentials (for CreateSandbox API)
VOLC_ACCESS_KEY=your_access_key
VOLC_SECRET_KEY=your_secret_key

# Region where your VeFaaS function is deployed (default: cn-beijing)
VEFAAS_REGION=cn-beijing

# (Optional) Pre-warmed sandbox instance name — skip auto-creation if set
# SANDBOX_INSTANCE_NAME=your_sandbox_instance_name
